# ─────────────────────────────────────────────────────────────────────────────
# Zeval environment variables — copy to .env and fill in real values.
# All ZEVAL_* names are canonical; SILICONFLOW_* / ZERORE_* kept for
# backwards-compat and must not be removed.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Judge (any OpenAI-compatible gateway) ─────────────────────────────────
ZEVAL_JUDGE_API_KEY=YOUR_API_KEY_HERE
ZEVAL_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
ZEVAL_JUDGE_MODEL=Qwen/Qwen3.5-27B
# Set to "true" to enable chain-of-thought thinking (only some models support it)
ZEVAL_JUDGE_ENABLE_THINKING=false

# Optional rubric research pass. Set a DeepSearch/web-research capable model if
# your OpenAI-compatible gateway exposes one. EXTRA_BODY is raw JSON merged into
# the chat/completions request, for provider-specific search flags.
ZEVAL_RUBRIC_DEEPSEARCH_MODEL=
ZEVAL_RUBRIC_DEEPSEARCH_EXTRA_BODY=

# Optional knowledge-base chunk embeddings. When unset, Zeval uses deterministic
# local lexical embeddings, so upload/search/rubric grounding still works offline.
ZEVAL_KNOWLEDGE_EMBEDDING_MODEL=
ZEVAL_KNOWLEDGE_EMBEDDING_BASE_URL=
ZEVAL_KNOWLEDGE_EMBEDDING_API_KEY=
ZEVAL_KNOWLEDGE_EMBEDDING_DIMENSIONS=

# Optional Eval-Anything-style Panel of LLM Judges. Keep "single" for lower cost;
# set "panel" to run independent judge members and aggregate disagreement.
ZEVAL_JUDGE_PANEL_MODE=single
# Format: judge_id:model:family,judge_id:model:family
# Example: openai:gpt-5.4:openai,deepseek:deepseek-v4-flash:deepseek,kimi:kimi-k2.6:moonshot
ZEVAL_JUDGE_PANEL_MEMBERS=
ZEVAL_JUDGE_PANEL_AGGREGATION=trimmed_mean
# Scores are 0-5 in Zeval; 1.5 mirrors Eval-Anything's 0.3 disagreement threshold.
ZEVAL_JUDGE_PANEL_DISAGREEMENT_THRESHOLD=1.5

# Max concurrent LLM judge calls per pipeline run (default 4).
# Raise carefully — higher values risk rate-limit 429s.
ZEVAL_JUDGE_CONCURRENCY=4
# Benchmark mode: max cases/matrix-cell submissions processed concurrently.
ZEVAL_BENCHMARK_SUBMISSION_CONCURRENCY=2
# Benchmark judge mode: "per_metric" for highest precision, "session_batch" for two-stage fast scan + recheck.
ZEVAL_BENCHMARK_JUDGE_MODE=per_metric
# In session_batch mode, batch results below this confidence fall back to per-metric recheck.
ZEVAL_BENCHMARK_BATCH_RECHECK_CONFIDENCE=0.65
# Benchmark mode: max rubric metrics judged concurrently for one submission.
ZEVAL_BENCHMARK_METRIC_CONCURRENCY=2
# Benchmark mode: max Judge Panel members judged concurrently for one metric.
ZEVAL_JUDGE_PANEL_CONCURRENCY=2

# Legacy fallbacks — DO NOT REMOVE (still read by siliconflow.ts)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=
SILICONFLOW_ENABLE_THINKING=

# ── Online eval: customer Reply API ──────────────────────────────────────────
# POST /reply endpoint base URL for online replay (baseline re-evaluation).
ZEVAL_CUSTOMER_API_URL=
# Legacy alias (still read by resolveReplyEndpoint)
SILICONFLOW_CUSTOMER_API_URL=

# ── Admission pipeline tuning ─────────────────────────────────────────────────
# Fraction of clean (non-bad) sessions sampled as TN golden cases (0–1).
ZEVAL_ADMISSION_TN_SAMPLE_RATE=0.05
# Fraction of TP/TN cases that require human review before entering the pool (0–1).
# 1.0 = all TP/TN cases go through human review; 0.0 = skip human gate entirely.
ZEVAL_ADMISSION_HUMAN_SAMPLING_RATE=1.0
# LLM judge confidence band that triggers the "uncertainty" channel.
ZEVAL_UNCERTAINTY_CONF_LO=0.4
ZEVAL_UNCERTAINTY_CONF_HI=0.6

# ── Tenancy ────────────────────────────────────────────────────────────────────
# Data is isolated by Organization → Project.  workspaceId is a legacy alias.
ZEVAL_DEFAULT_ORGANIZATION_ID=default-org

# ── Database ───────────────────────────────────────────────────────────────────
# Use "local-json" for local dev (filesystem store, no external DB required).
# Use "postgres" to enable the Postgres/Supabase adapter.
ZEVAL_DATABASE_ADAPTER=local-json

# Uncomment when ZEVAL_DATABASE_ADAPTER=postgres:
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
ZEVAL_POSTGRES_SSL=auto
ZEVAL_POSTGRES_POOL_MAX=5

# Dataset / baseline store providers (filesystem = local .zeval-db/)
DATASET_STORE_PROVIDER=filesystem
WORKBENCH_BASELINE_STORE_PROVIDER=filesystem

# ── Supabase metadata (only needed when ZEVAL_DATABASE_ADAPTER=postgres) ──────
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_PROJECT_REF=YOUR_REF

# ── Optional: intent experiment pilot ─────────────────────────────────────────
# Falls back to ZEVAL_JUDGE_API_KEY when unset.
ZEVAL_INTENT_EXPERIMENT_API_KEY=

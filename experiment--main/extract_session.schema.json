{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent Pointer Pilot Session Asset",
  "type": "object",
  "required": [
    "schema_version",
    "schema_lock_revision",
    "prompt_version",
    "session_id",
    "intent_sequence",
    "refillables"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "schema_lock_revision": { "type": "integer", "minimum": 1 },
    "prompt_version": { "type": "string" },
    "session_id": { "type": "string" },
    "intent_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "intent_index",
          "intent_text",
          "turn_span_user_turns",
          "example_user_queries",
          "success_criteria",
          "depends_on"
        ],
        "properties": {
          "intent_index": { "type": "integer", "minimum": 1 },
          "intent_text": { "type": "string" },
          "turn_span_user_turns": { "type": "integer", "minimum": 1 },
          "example_user_queries": { "type": "array", "items": { "type": "string" } },
          "success_criteria": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "historical_span": {
            "type": ["object", "null"],
            "properties": {
              "start_turn_index": { "type": "integer", "minimum": 0 },
              "end_turn_index": { "type": "integer", "minimum": 0 }
            },
            "required": ["start_turn_index", "end_turn_index"]
          },
          "n_i_conflict": { "type": "boolean" },
          "n_i_heuristic": { "type": "boolean" }
        }
      }
    },
    "refillables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "refill_index",
          "trigger_condition",
          "refill_reference"
        ],
        "properties": {
          "refill_index": { "type": "integer", "minimum": 1 },
          "trigger_condition": { "type": "string" },
          "refill_reference": { "type": "string" },
          "key": { "type": "string" },
          "source_turn_index": { "type": ["integer", "null"] },
          "confidence": { "type": "string" },
          "injection_text": { "type": "string" },
          "bind_intent_index": { "type": ["integer", "null"] }
        }
      }
    }
  }
}

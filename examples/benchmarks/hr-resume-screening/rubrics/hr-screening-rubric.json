      "metrics": [
        {
          "metricKey": "decision_accuracy",
          "capability": "task_completion",
          "displayName": "Decision accuracy",
          "description": "The agent's select/reject decision matches the gold decision.",
          "evaluatorType": "exact_match",
          "weight": 5,
          "scale": { "min": 0, "max": 5, "passThreshold": 5 },
          "approvalStatus": "approved",
          "evidenceRequired": true,
          "humanApprovalRequired": false,
          "failureTags": ["wrong_decision"],
          "config": {
            "outputPath": "parsedOutput.decision",
            "expectedPath": "expected.decision"
          }
        }
      ]
    },
    {
      "capability": "reasoning_quality",
      "displayName": "Reasoning quality",
      "description": "Whether the explanation is aligned with the resume, job description, and reference reason.",
      "weight": 3,
      "metrics": [
        {
          "metricKey": "reason_alignment",
          "capability": "reasoning_quality",
          "displayName": "Reason alignment",
          "description": "The agent's reason cites relevant skills or gaps and does not rely on unsupported claims.",
          "evaluatorType": "llm_judge",
          "weight": 3,
          "scale": { "min": 0, "max": 5, "passThreshold": 3 },
          "approvalStatus": "approved",
          "evidenceRequired": true,
          "humanApprovalRequired": true,
          "failureTags": ["unsupported_reason", "reason_mismatch"],
          "config": {
            "criteria": "Compare the agent reason against the resume, job description, and reference reason. Penalize invented facts and vague explanations."
          }
        }
      ]
    },
    {
      "capability": "factual_grounding",
      "displayName": "Factual grounding",
      "description": "Whether the cited evidence exists in the input documents.",
      "weight": 3,
      "metrics": [
        {
          "metricKey": "citation_accuracy",
          "capability": "factual_grounding",
          "displayName": "Citation accuracy",
          "description": "Evidence statements are grounded in the provided resume or job description.",
          "evaluatorType": "llm_judge",
          "weight": 3,
          "scale": { "min": 0, "max": 5, "passThreshold": 3 },
          "approvalStatus": "approved",
          "evidenceRequired": true,
          "humanApprovalRequired": true,
          "failureTags": ["hallucination", "missing_evidence"],
          "config": {
            "criteria": "Check every evidence bullet against the input. Penalize unsupported, fabricated, or irrelevant evidence."
          }
        }
      ]
    },
    {
      "capability": "format_compliance",
      "displayName": "Format compliance",
      "description": "Whether the output can be parsed by downstream automation.",
      "weight": 2,
      "metrics": [
        {
          "metricKey": "output_schema_valid",
          "capability": "format_compliance",
          "displayName": "Output schema valid",
          "description": "The answer is a JSON object containing decision, reason, and evidence.",
